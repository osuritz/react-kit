{
  "name": "@osuritz/react-kit",
  "version": "1.0.0",
  "description": "Lightweight, copy-paste React hooks and utilities for common frontend patterns.",
  "keywords": [
    "enterprise",
    "hooks",
    "react"
  ],
  "homepage": "https://github.com/osuritz/react-kit#readme",
  "bugs": {
    "url": "https://github.com/osuritz/react-kit/issues"
  },
  "license": "MIT",
  "author": "Olivier Suritz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osuritz/react-kit.git"
  },
  "type": "module",
  "main": "index.js",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "preview": "vite preview",
    "test": "pnpm -r run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-router": "^7.15.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "shiki": "^4.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.1.3"
}
